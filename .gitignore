# ===== Monorepo: CobbleMarket (Backend .NET + Frontend Angular/Electron) =====

# OS
.DS_Store
Thumbs.db

# IDE / Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/mcp.json
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.DotSettings.user

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Env / Secrets
.env
.env.*
!.env.example
secrets.json

# =========================
# Backend (.NET)
# =========================
**/bin/
**/obj/
**/TestResults/
*.nupkg
*.snupkg

# Local DB / runtime data
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Keep seed JSONs (important)
!CobblemonMarketApi/DataSeed/
!CobblemonMarketApi/DataSeed/*.json

# Keep appsettings tracked (adapt if you add secrets later)
!CobblemonMarketApi/appsettings.json
!CobblemonMarketApi/appsettings.Development.json

# =========================
# Frontend (Angular)
# =========================
**/node_modules/
**/dist/
**/.angular/
**/coverage/
**/tmp/
**/out-tsc/
**/.sass-cache/
**/.history/
**/testem.log
**/connect.lock
**/libpeerconnection.log

# =========================
# Electron / Packaging
# =========================
**/release/
**/win-unpacked/
**/builder-debug.yml
**/builder-effective-config.yaml
**/*.blockmap
**/*.asar

# Generated embedded backend binaries for Electron
**/electron/backend-publish/
# (the one that caused GitHub >100MB errors)
**/electron/backend-publish/*.exe

# Misc
*.pid
*.seed
